rules_version = '2';

// foodie · Cloud Firestore security rules.
// Deny by default. A signed-in user can read and write only what lives under users/{their own uid}.
// The shapes below mirror app/core/cloudmap.js. Rules cannot loop over map entries, so what is inside a meal
// (names, items, per-100 g values) is checked by the app's cleaners on every read and write; the rules cap how
// many entries each map may hold and keep every field to its type and range. A user can only ever damage their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // true when the field is absent, or present and a number inside [lo, hi]
    function optNumber(d, field, lo, hi) {
      return !(field in d) || (d[field] is number && d[field] >= lo && d[field] <= hi);
    }

    // true when the field is absent, or present and a map with at most `max` entries
    function optMap(d, field, max) {
      return !(field in d) || (d[field] is map && d[field].size() <= max);
    }

    function optList(d, field, max) {
      return !(field in d) || (d[field] is list && d[field].size() <= max);
    }

    // a stamp is milliseconds since 1970: 0 .. year 3000
    function optStamp(d, field) {
      return optNumber(d, field, 0, 32503680000000);
    }

    // ---- end-to-end encryption of the cloud copy (core/crypto.js, core/cloudseal.js) -------------------------------------------------
    // PHASE 1 (now): plaintext documents (written by app versions from before encryption) and encrypted ones are both accepted, so a phone that
    // still runs an old copy of the app keeps working while everybody updates. PHASE 2: change plaintextAllowed() to return false and publish;
    // from then on only the encrypted fields are accepted. That is the ONLY line that differs between the two phases.
    function plaintextAllowed() {
      return true;
    }

    // a sealed record: { v: 1, iv: 12 random bytes as 16 base64 characters, ct: ciphertext with its 16-byte tag as base64 }
    function isSealed(b, maxCt) {
      return b is map
        && b.keys().hasOnly(['v', 'iv', 'ct'])
        && b.keys().hasAll(['v', 'iv', 'ct'])
        && b.v == 1
        && b.iv is string && b.iv.size() == 16
        && b.ct is string && b.ct.size() >= 24 && b.ct.size() <= maxCt;
    }

    function optSealed(d, field, maxCt) {
      return !(field in d) || isSealed(d[field], maxCt);
    }

    // users/{uid}.crypto: the passphrase verifier (salt, PBKDF2 iterations, a sealed check string). 600,000 iterations is the floor.
    function validCrypto(c) {
      return c is map
        && c.keys().hasOnly(['v', 'salt', 'iter', 'check'])
        && c.keys().hasAll(['v', 'salt', 'iter', 'check'])
        && c.v == 1
        && c.salt is string && c.salt.size() == 24
        && c.iter is int && c.iter >= 600000 && c.iter <= 10000000
        && isSealed(c.check, 256);
    }

    // Rules cannot loop over a map, so the entries of mealsE / itemsE / goalsE / wE are not checked one by one: the rules cap how many there are
    // (and Firestore caps the document at 1 MiB); the app's cleaners and the encryption itself decide what an entry is worth when it is read.
    function validUser(d) {
      return d.keys().hasOnly(plaintextAllowed()
          ? ['profile', 'profileE', 'goals', 'goalsE', 'profileAt', 'goalsAt', 'crypto', 'updatedAt']
          : ['profileE', 'goalsE', 'profileAt', 'goalsAt', 'crypto', 'updatedAt'])
        && (!('profile' in d) || d.profile is map)
        && optList(d, 'goals', 1000)
        && optMap(d, 'goalsAt', 1000)
        && optSealed(d, 'profileE', 4096)
        && optMap(d, 'goalsE', 1000)
        && (!('crypto' in d) || validCrypto(d.crypto))
        && optStamp(d, 'profileAt')
        && optStamp(d, 'updatedAt');
    }

    function validDay(d) {
      return d.keys().hasOnly(plaintextAllowed()
          ? ['meals', 'mealsE', 'deleted', 'waterMl', 'waterE', 'waterAt', 'steps', 'stepsE', 'stepsAt', 'updatedAt']
          : ['mealsE', 'deleted', 'waterE', 'waterAt', 'stepsE', 'stepsAt', 'updatedAt'])
        && optMap(d, 'meals', 100)
        && optMap(d, 'mealsE', 100)
        && optMap(d, 'deleted', 500)
        && optNumber(d, 'waterMl', 0, 20000)
        && optNumber(d, 'steps', 0, 200000)
        && optSealed(d, 'waterE', 1024)
        && optSealed(d, 'stepsE', 1024)
        && optStamp(d, 'waterAt')
        && optStamp(d, 'stepsAt')
        && optStamp(d, 'updatedAt');
    }

    function validSaved(d) {
      return d.keys().hasOnly(plaintextAllowed() ? ['items', 'itemsE', 'deleted', 'updatedAt'] : ['itemsE', 'deleted', 'updatedAt'])
        && optMap(d, 'items', 300)
        && optMap(d, 'itemsE', 300)
        && optMap(d, 'deleted', 500)
        && optStamp(d, 'updatedAt');
    }

    function validWeights(d) {
      return d.keys().hasOnly(plaintextAllowed() ? ['w', 'wE', 'at', 'updatedAt'] : ['wE', 'at', 'updatedAt'])
        && optMap(d, 'w', 4000)
        && optMap(d, 'wE', 4000)
        && optMap(d, 'at', 4000)
        && optStamp(d, 'updatedAt');
    }

    // the daily photo counter (core/limits.js): a local day and a whole number of photos
    function validUsage(d) {
      return d.keys().hasOnly(['day', 'photos', 'updatedAt'])
        && 'day' in d && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && 'photos' in d && d.photos is int && d.photos >= 0 && d.photos <= 1000
        && optStamp(d, 'updatedAt');
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(request.resource.data);
      allow delete: if isOwner(uid);

      match /days/{iso} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && iso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && validDay(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /meta/saved {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSaved(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /meta/usage {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid) && validUsage(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /meta/weights {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWeights(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
